# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real key.

# Any provider with an OpenAI-compatible /chat/completions endpoint works.
# Example (Groq): https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
# Use a model name that is currently listed in your provider's dashboard.
LLM_MODEL=

# Optional: true only if your provider supports response_format json_object
LLM_JSON_MODE=false
# Optional: reasoning effort for models that support it (for example low, medium, high)
LLM_REASONING=
